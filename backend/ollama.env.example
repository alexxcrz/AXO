# Variables de IA local (Ollama) — SOLO desarrollo en tu PC.
# 1. Copia a backend/.env.ollama.local (gitignored) o agrega estas lineas a backend/.env
# 2. Copia ollama.local.service.example.js -> ollama.local.service.js
# 3. Ejecuta: backend/scripts/setup-ollama.example.ps1

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=120000
OLLAMA_AXO_AI=true
